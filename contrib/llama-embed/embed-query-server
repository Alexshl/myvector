#!/bin/sh
# Query-only embedding server for myvec (config `query_url`): same llama-server and the SAME model file as
# embed-server (vectors must match the indexed ones), but its own process, one slot and a small batch, so a
# search query never waits behind indexing batches. 127.0.0.1:11436. Install: cp to ~/bin/embed-query-server, chmod +x.
LLAMA_SERVER="${LLAMA_SERVER:-$HOME/apps/llama.cpp/build/bin/llama-server}"
EMBED_MODEL="${EMBED_MODEL:-$HOME/models/embed/embeddinggemma-300M-Q8_0.gguf}"
exec "$LLAMA_SERVER" -m "$EMBED_MODEL" --embeddings --pooling mean -ngl 0 \
  -np 1 -c 2048 -b 2048 -ub 2048 --host 127.0.0.1 --port "${EMBED_QUERY_PORT:-11436}"
