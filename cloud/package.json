{
  "name": "myvec-pm-cloud",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "WRANGLER_SEND_METRICS=false wrangler dev --local --var ACCESS_DEV_BYPASS:1",
    "test": "WRANGLER_SEND_METRICS=false vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "WRANGLER_SEND_METRICS=false wrangler d1 migrations apply DB --local",
    "mint-token": "WRANGLER_SEND_METRICS=false node scripts/mint-token.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20260815.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.124.0"
  }
}
